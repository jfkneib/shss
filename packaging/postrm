#!/bin/sh
set -e

SHSS_ROOT=/opt/shss

case "$1" in
    remove)
        rm -rf "$SHSS_ROOT/.venv"
        ;;
    purge)
        rm -rf "$SHSS_ROOT/.venv" "$SHSS_ROOT/model"
        echo "shss: la ligne 'source $SHSS_ROOT/shell-integration/shss.bash'"
        echo "shss: ajoutee a un ~/.bashrc n'est pas retiree automatiquement."
        echo "shss: supprime-la a la main si besoin."
        ;;
esac

exit 0
