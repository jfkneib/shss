#!/bin/sh
set -e

SHSS_ROOT=/opt/shss
MODEL_URL="https://huggingface.co/QuantFactory/Qwen2.5-Coder-1.5B-GGUF/resolve/main/Qwen2.5-Coder-1.5B.Q4_K_M.gguf"

case "$1" in
    configure)
        echo "shss: creation de l'environnement virtuel Python..."
        if [ ! -x "$SHSS_ROOT/.venv/bin/python" ]; then
            python3 -m venv "$SHSS_ROOT/.venv"
        fi
        "$SHSS_ROOT/.venv/bin/pip" install --quiet --upgrade pip
        "$SHSS_ROOT/.venv/bin/pip" install --quiet -r "$SHSS_ROOT/requirements.txt"

        mkdir -p "$SHSS_ROOT/model"
        if [ ! -e "$SHSS_ROOT/model/model.gguf" ]; then
            FOUND=$(PYTHONPATH="$SHSS_ROOT/src" "$SHSS_ROOT/.venv/bin/python" -c '
from shss.llm import discover_gguf_path
try:
    print(discover_gguf_path())
except FileNotFoundError:
    pass
' 2>/dev/null || true)

            if [ -n "$FOUND" ]; then
                echo "shss: modele deja present, reutilise depuis $FOUND"
                ln -sf "$FOUND" "$SHSS_ROOT/model/model.gguf"
            else
                echo "shss: telechargement du modele qwen2.5-coder-1.5b-base (~950 Mo)..."
                if command -v curl >/dev/null 2>&1; then
                    curl -fL --progress-bar -o "$SHSS_ROOT/model/model.gguf.part" "$MODEL_URL"
                else
                    wget -O "$SHSS_ROOT/model/model.gguf.part" "$MODEL_URL"
                fi
                mv "$SHSS_ROOT/model/model.gguf.part" "$SHSS_ROOT/model/model.gguf"
            fi
        else
            echo "shss: modele deja installe ($SHSS_ROOT/model/model.gguf), rien a faire"
        fi

        find "$SHSS_ROOT" -type d -exec chmod go+rx {} +
        find "$SHSS_ROOT" -type f -exec chmod go+r {} +

        TARGET_USER="${SUDO_USER:-}"
        if [ -z "$TARGET_USER" ] && [ "$(id -u)" != "0" ]; then
            TARGET_USER="$(id -un)"
        fi

        LINE="source $SHSS_ROOT/shell-integration/shss.bash"
        if [ -n "$TARGET_USER" ]; then
            TARGET_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)
            BASHRC="$TARGET_HOME/.bashrc"
            if [ -f "$BASHRC" ] && ! grep -qF "$LINE" "$BASHRC"; then
                printf '\n# shss: Ctrl-G resout les blocs #@ ... @# dans le prompt\n%s\n' "$LINE" >> "$BASHRC"
                chown "$TARGET_USER" "$BASHRC" 2>/dev/null || true
                echo "shss: integration Ctrl-G ajoutee a $BASHRC"
                echo "shss: ouvre un nouveau terminal (ou lance: source $BASHRC)"
            else
                echo "shss: integration Ctrl-G deja presente dans $BASHRC"
            fi
        else
            echo "shss: ajoute manuellement cette ligne a ton ~/.bashrc :"
            echo "  $LINE"
        fi

        echo "shss: installation terminee. Essaie : shss -c 'ls #@ trie par taille @#'"
        ;;
esac

exit 0
